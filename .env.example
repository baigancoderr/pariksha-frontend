# ParikshaBhumi Frontend Environment Variables

# API Base URL
# For production, set this in the frontend host environment to the deployed API URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# App Configuration
VITE_APP_NAME=ParikshaBhumi
VITE_APP_NAME_HI=परीक्षाभूमि

# Environment
VITE_NODE_ENV=development

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Base Path (for deployment in subdirectory)
VITE_BASE_PATH=/
